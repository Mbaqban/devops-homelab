k8s_network: k8s-net
vagrant_k8s_image: "k8s-base"
pubkey: "/home/mbaqban/.ssh/id_rsa.pub"

pod_cidr: "10.244.0.0/16"
control_plane_endpoint: "192.168.56.20:6443"
kube_vip_version: "v1.2.3"

flannel_manifest_url: "https://github.com/flannel-io/flannel/releases/latest/download/kube-flannel.yml"
metric_manifest_url: "https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml"

custom_vm_storage: "vmstorage"

nodes:
  - name: k8s-master
    ip: 192.168.56.10
    cpus: 2
    mem: 2048 
    master: true

  - name: k8s-master2
    ip: 192.168.56.11
    cpus: 2
    mem: 2048
    master: true

  - name: k8s-master3
    ip: 192.168.56.12
    cpus: 2
    mem: 2048
    master: true

  - name: k8s-worker1
    ip: 192.168.56.13
    cpus: 2
    mem: 2048
    master: false

  - name: k8s-worker2
    ip: 192.168.56.14
    cpus: 2
    mem: 2048
    master: false

  - name: k8s-worker3
    ip: 192.168.56.15
    cpus: 2
    mem: 2048
    master: false